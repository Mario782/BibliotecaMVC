@model IEnumerable<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Reportería de Libros";
    var autorFiltro = ViewBag.AutorFiltro as string;
    var generoFiltro = ViewBag.GeneroFiltro as string;
    var generos = ViewBag.GenerosDisponibles as List<string> ?? new List<string>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>📊 Módulo de Reportería - Libros</h2>
        <div>
            <a asp-action="GenerarPdf" asp-route-autor="@autorFiltro" asp-route-genero="@generoFiltro" class="btn btn-danger me-2">
                📄 Generar reporte PDF
            </a>
            <a asp-action="ExportarExcel" asp-route-autor="@autorFiltro" asp-route-genero="@generoFiltro" class="btn btn-success">
                📗 Exportar a Excel
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Filtrar por Autor</label>
                    <input type="text" name="autor" value="@autorFiltro" class="form-control" placeholder="Ej. Homero" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Filtrar por Categoría / Género</label>
                    <select name="genero" class="form-select">
                        <option value="">-- Todos los géneros --</option>
                        @foreach (var g in generos)
                        {
                            <option value="@g" selected="@(g == generoFiltro)">@g</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary me-2">Aplicar Filtros</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="alert alert-info py-2">
        <strong>Resumen:</strong> Se exportarán <strong>@Model.Count()</strong> libro(s) con los criterios actuales.
    </div>

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Título</th>
                <th>Autor</th>
                <th>Género / Categoría</th>
                <th>Año</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td class="fw-bold">@item.Titulo</td>
                    <td>@item.Autor</td>
                    <td>@item.Genero</td>
                    <td>@item.AnioPublicacion</td>
                </tr>
            }
        </tbody>
    </table>
</div>