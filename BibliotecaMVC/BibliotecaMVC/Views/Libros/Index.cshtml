@model IEnumerable<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Catálogo de Libros";
}

<h2 class="mb-4">Catálogo de Libros</h2>
<p>
    <a asp-action="Create" class="btn btn-success">Agregar Nuevo Libro</a>
</p>

<div class="row">
    @foreach (var libro in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="~/Imagenes/@libro.ImagenUrl" class="card-img-top" alt="Portada de @libro.Titulo" style="height: 250px; object-fit: cover;">

                <div class="card-body">
                    <h5 class="card-title">@libro.Titulo</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@libro.Autor</h6>
                    <hr />
                    <p class="card-text">
                        <strong>Categoría:</strong> @libro.Categoria <br />
                        <strong>Precio:</strong> $@libro.Precio <br />
                        <strong>Estado:</strong>
                        @if (libro.Disponible)
                        {
                            <span class='badge bg-success'>Disponible</span>
                        }
                        else
                        {
                            <span class='badge bg-danger'>Agotado</span>
                        }
                    </p>
                </div>
                <div class="card-footer bg-white text-center">
                    <a asp-action="Details" asp-route-id="@libro.ID" class="btn btn-info btn-sm text-white">Detalles</a>
                    <a asp-action="Edit" asp-route-id="@libro.ID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@libro.ID" class="btn btn-danger btn-sm">Eliminar</a>
                </div>
            </div>
        </div>
    }
</div>