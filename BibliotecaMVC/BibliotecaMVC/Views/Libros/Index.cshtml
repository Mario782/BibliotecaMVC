@model IEnumerable<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Listado de Libros";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>📚 Inventario de Libros</h2>
        @if (User.IsInRole("Admin") || User.IsInRole("Bibliotecario"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Registrar Nuevo Libro
            </a>
        }
    </div>

    <table class="table table-striped table-hover align-middle shadow-sm rounded">
        <thead class="table-dark">
            <tr>
                <th>Título</th>
                <th>Autor</th>
                <th>Género</th>
                <th>Año</th>
                @if (User.IsInRole("Admin") || User.IsInRole("Bibliotecario"))
                {
                    <th class="text-center">Acciones</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.Titulo</td>
                    <td>@item.Autor</td>
                    <td><span class="badge bg-secondary">@item.Genero</span></td>
                    <td>@item.AnioPublicacion</td>
                    @if (User.IsInRole("Admin") || User.IsInRole("Bibliotecario"))
                    {
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1">
                                Editar
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                Eliminar
                            </a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>