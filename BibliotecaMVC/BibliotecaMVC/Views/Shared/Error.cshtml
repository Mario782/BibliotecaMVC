@{
    ViewData["Title"] = "Error en el sistema";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7 text-center">
            <div class="card shadow border-0 rounded-4 border-bottom border-5 border-danger">
                <div class="card-body p-5">
                    <h1 class="display-1 text-danger"><i class="bi bi-exclamation-triangle-fill"></i></h1>
                    <h2 class="fw-bold mt-3">¡Oops! Algo salió mal.</h2>
                    <p class="text-muted fs-5 mt-3">
                        Ha ocurrido un problema inesperado procesando tu solicitud. Nuestro equipo técnico ha sido notificado.
                    </p>
                    <div class="alert alert-light border mt-4 text-start" role="alert">
                        💡 <strong>Sugerencia:</strong> Intenta refrescar la página o volver al menú principal.
                    </div>
                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-danger btn-lg px-5 rounded-pill shadow-sm">
                            <i class="bi bi-house-door"></i> Volver al Inicio
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>