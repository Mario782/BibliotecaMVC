@{
    ViewData["Title"] = "Acerca de";
}

<!-- Estructura Semántica HTML5 (Act. 2 y 3) -->
<main class="about-container mt-4">
    <header class="about-header">
        <h1>Acerca de la Biblioteca Virtual</h1>
        <p>Promoviendo la lectura y el aprendizaje continuo en la era digital.</p>
    </header>

    <section class="about-content">
        <article class="about-mission">
            <h2>Nuestra Misión</h2>
            <p>Proveer acceso rápido, gratuito y organizado a recursos educativos y obras literarias de impacto mundial. Creemos firmemente que el conocimiento debe estar al alcance de todos con tan solo un clic.</p>
            <p>Desde novelas de fantasía hasta libros técnicos de programación, nuestro catálogo está diseñado para inspirar.</p>
        </article>

        <aside class="about-services">
            <h2>Servicios Especiales</h2>
            <ul>
                <li>Préstamos de e-books</li>
                <li>Club de lectura semanal</li>
                <li>Foros con autores destacados</li>
                <li>Categorías personalizadas</li>
            </ul>
        </aside>
    </section>
</main>