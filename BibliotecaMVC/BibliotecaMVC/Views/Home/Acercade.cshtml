@{
    ViewData["Title"] = "Acerca de";
}

<main class="about-container mt-4">
    <header class="about-header text-center border-bottom pb-3 mb-4">
        <h1>Acerca de la Biblioteca Virtual</h1>
        <p class="text-muted">Promoviendo la lectura y el aprendizaje continuo en la era digital.</p>
    </header>

    <section class="about-mission mb-5 p-4 bg-light rounded shadow-sm">
        <h2 class="text-center mb-3">Nuestra Misión</h2>
        <p class="text-center">Proveer acceso rápido, gratuito y organizado a recursos educativos y obras literarias de impacto mundial. Creemos firmemente que el conocimiento debe estar al alcance de todos con tan solo un clic.</p>
    </section>

    <h2 class="text-center mb-4 border-bottom pb-2">Servicios Especiales</h2>


    <section class="contenedor-flex">
        <article class="tarjeta-reutilizable">
            <i class="bi bi-device-ssd"></i>
            <h5>Préstamos de E-books</h5>
            <p>Descarga directa a tus dispositivos para lectura offline.</p>
        </article>

        <article class="tarjeta-reutilizable">
            <i class="bi bi-people"></i>
            <h5>Club de Lectura</h5>
            <p>Reuniones semanales virtuales para debatir nuestros libros favoritos.</p>
        </article>

        <article class="tarjeta-reutilizable">
            <i class="bi bi-star"></i>
            <h5>Foros Especiales</h5>
            <p>Encuentros virtuales con autores y expertos de renombre.</p>
        </article>
    </section>
</main>
