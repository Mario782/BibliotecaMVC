@model BibliotecaMVC.Models.Categoria

@{
    ViewData["Title"] = "Eliminar Categoría";
}

<div class="container mt-4">
    <h2 class="text-danger">Eliminar Categoría</h2>
    <h4 class="mb-4">¿Estás seguro de que deseas eliminar esta categoría? Esta acción no se puede deshacer.</h4>

    <div class="card shadow-sm p-4 mb-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nombre:</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>

            <dt class="col-sm-3">Descripción:</dt>
            <dd class="col-sm-9">@Model.Descripcion</dd>
        </dl>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="¡Sí, Eliminar Definitivamente!" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>